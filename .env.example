# Copy to .env and adjust as needed. docker-compose overrides DB/Redis/S3 host
# settings directly for the api/worker services; this file is mainly for
# variables you want to pass to both without editing docker-compose.yml.

USE_REAL_DEMUCS=true
INSTALL_DEMUCS=true
DEMUCS_MODEL=htdemucs_ft

# Only relevant when running outside Docker Compose against your own S3/R2 bucket:
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=dissecttune
S3_REGION=us-east-1

# Local-only default. Replace with a random secret before exposing the API.
AUTH_SECRET=local-development-only-change-before-hosting
MAX_UPLOAD_MB=50
MAX_DURATION_SECONDS=300
MAX_PROJECT_TRACKS=4
