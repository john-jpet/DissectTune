# Local Docker defaults. Replace AUTH_SECRET before any public deployment.
USE_REAL_DEMUCS=true
INSTALL_DEMUCS=true
DEMUCS_MODEL=htdemucs_ft
API_PORT=8000

# Local MinIO defaults. Change all credentials for public hosting.
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=dissecttune
S3_REGION=us-east-1
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
MAX_UPLOAD_MB=50
MAX_DURATION_SECONDS=300
MAX_PROJECT_TRACKS=4
